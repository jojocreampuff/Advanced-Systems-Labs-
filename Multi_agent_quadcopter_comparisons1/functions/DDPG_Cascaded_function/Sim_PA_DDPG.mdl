<?xml version="1.0" encoding="utf-8"?>
<chart id="116">
  <P Name="name">System Solver/System Solver</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">116</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">16</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">10</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">system_solver</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">116</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [roll, pitch, r_yaw, ft ] = system_solver(u1, u2, u3, Ts, r_yaw)

    m = 1; g = 9.81;
    
    ft = m * sqrt( u1^2 + u2^2 + (u3-g)^2 );

    % a = sin(r_yaw);
    % b = cos(r_yaw);
    % 
    % A = u1 / (u3);
    % B = u2 / (u3);
    % C = (a*A - b*B) / ( (a^2) + (b^2)) ;
    % 
    % roll = atan( (B + b*C) / a );
    % pitch = atan( C * cos(roll) );

    roll = asin( (u2*m) / ft );
    pitch = asin( (-u1*m) / (ft*cos(roll)) );
    r_yaw = 0;

    % Smoothing Factor ( Use exponential decay, just to start from zero )
    % roll = roll * (1-exp(-Ts));
    % pitch = pitch * (1-exp(-Ts));
    % r_yaw = r_yaw * (1-exp(-Ts));

    % Saturation
    if roll &gt; pi/10
        roll = pi/10;
    elseif roll &lt; -pi/10
        roll = -pi/10;
    end

    if pitch &gt; pi/10
        pitch = pi/10;
    elseif pitch &lt; -pi/10
        pitch = -pi/10;
    end

end

% function [ft, pitch, roll] = system_solve(u1, u2, u3, psi, m) % u1 = ux , u2 = uy , u3 = uz - g  
%     if psi &lt;= 0.001 &amp;&amp; psi &gt;= -0.001
%         psi = 0.001;
%     end
%     a = sin(psi);
%     b = cos(psi);
% 
%     A = u1 / (u3);
%     B = u2 / (u3);
%     C = (a*A - b*B) / ( (a^2) + (b^2)) ;
% 
%     roll = atan( (B + b*C) / a );
%     pitch = atan( C * cos(roll) );
% 
%     % saftey limit threshold on desired pitch and roll
%     if pitch&gt;pi/4
%         pitch = pi/4;
%     elseif pitch&lt;-pi/4
%         pitch = -pi/4;
%     end
%     if roll&gt;pi/4
%         roll = pi/4;
%     elseif roll&lt;-pi/4
%         roll = -pi/4;
%     end
%     ft = ( m / (cos(pitch)*cos(roll)) ) * (-u3); 
% end



</P>
      </eml>
    </state>
    <data SSID="6" name="roll">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="pitch">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
