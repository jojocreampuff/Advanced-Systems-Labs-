<?xml version="1.0" encoding="utf-8"?>
<chart id="153">
  <P Name="name">Position DDPG/Position Error</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">153</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">29</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">12</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">calculate_errors</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">153</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [e_x, e_y, e_z, e_xdot, e_ydot, e_zdot] = ...
      calculate_errors(x_desired, y_desired, z_desired, ...
      xdot_desired, ydot_desired, zdot_desired, ...
      x,y,z, xdot,ydot,zdot)

    e_x    = x_desired - x;
    e_y    = y_desired - y;
    e_z    = z_desired - z;
    e_xdot = xdot_desired - xdot;
    e_ydot = ydot_desired - ydot;
    e_zdot = zdot_desired - zdot;
    
end

