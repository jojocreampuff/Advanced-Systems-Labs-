  <eml>
    <P Name="name">calculate_reward</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">176</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [r,isdone] = calculate_reward(e_x, e_y, e_z, e_u, e_v, e_w, u_dot, v_dot, w_dot)

    r = -    1*( abs(e_x)   + abs(e_y)   + abs(e_z) ) ...
        -  0.1*( abs(e_u)   + abs(e_v)   + abs(e_w) ) ...
        - 0.01*( abs(u_dot) + abs(v_dot) + abs(w_dot) );
    
   isdone = 0;
   
end
</P>
      </eml>
    </state>
