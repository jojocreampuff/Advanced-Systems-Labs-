        <P Name="isEML">1</P>
        <P Name="script">function [ e_phi, e_theta, e_psi, e_phi_dot, e_theta_dot, e_psi_dot ] = calculate_errors(phi_dsr, phi_dot_dsr, theta_dsr, theta_dot_dsr, psi_dsr, psi_dot_dsr, phi, theta, psi, phi_dot, theta_dot, psi_dot)
   
    e_phi = phi_dsr - phi;
    e_theta = theta_dsr - theta;
    e_psi = psi_dsr - psi;

    e_phi_dot = phi_dot_dsr - phi_dot;
    e_theta_dot = theta_dot_dsr - theta_dot;
    e_psi_dot = psi_dot_dsr - psi_dot;

end</P>
