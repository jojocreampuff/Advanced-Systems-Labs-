<?xml version="1.0" encoding="utf-8"?>
<chart id="141">
  <P Name="name">leader 1/Attitude DDPG/Attitude Error</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">141</P>
  <P Name="ssIdHighWaterMark">29</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">11</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">calculate_errors</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">141</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [ e_phi, e_theta, e_psi, e_phi_dot, e_theta_dot, e_psi_dot ] = calculate_errors(phi_dsr, phi_dot_dsr, theta_dsr, theta_dot_dsr, psi_dsr, psi_dot_dsr, phi, theta, psi, phi_dot, theta_dot, psi_dot)
   
    e_phi = phi_dsr - phi;
    e_theta = theta_dsr - theta;
    e_psi = psi_dsr - psi;

    e_phi_dot = phi_dot_dsr - phi_dot;
    e_theta_dot = theta_dot_dsr - theta_dot;
    e_psi_dot = psi_dot_dsr - psi_dot;

end</P>
      </eml>
    </state>
    <data SSID="21" name="phi_dsr">
