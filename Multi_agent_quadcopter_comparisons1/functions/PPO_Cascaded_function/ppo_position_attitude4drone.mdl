  <eml>
    <P Name="name">add_state_noise</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">265</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function noisy_vector = add_state_noise(state_vector,noise_percent)

    sensor_uncert = [0.02, 0.02, 0.05, 0.05, 0.05, 0.05, 0.15, 0.15, 0.5, 0.005, 0.005, 0.005]&apos;;
  
    noise = (noise_percent) * sensor_uncert .* randn(size(state_vector)); % 0.01 usually add noise_percent 1 2 3 4 5
    noisy_vector = state_vector + noise;

end</P>
      </eml>
    </state>
    <data SSID="4" name="state_vector">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
