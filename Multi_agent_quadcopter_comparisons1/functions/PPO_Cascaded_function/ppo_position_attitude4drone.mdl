  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">408</P>
  <P Name="ssIdHighWaterMark">19</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">39</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">408</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function reward  = fcn(err, u)

    % reward = -0.1 * (err.&apos; * Q_pos * err + u.&apos; * R_pos * u);
    err1 = err(1); % x
    err2 = err(2); % x_dot
    err3 = err(3);
    err4 = err(4);
    err5 = err(5);
    err6 = err(6);

    ux = u(1);
    uy = u(2);
    uz = u(3);

    reward = -0.05*(1*abs(err1) + 0.1*abs(err2) + 1*abs(err3) + 0.1*abs(err4) + ...
                    1*abs(err5) + 0.1*abs(err6) + 0.1*abs(ux) + 0.1*abs(uy) + 0.1*abs(uz));

end
</P>
      </eml>
    </state>
