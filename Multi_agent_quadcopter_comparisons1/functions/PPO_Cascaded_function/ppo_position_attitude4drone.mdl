      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function noisy_vector = add_state_noise(state_vector,noise_percent)

    sensor_uncert = [0.02, 0.02, 0.05, 0.05, 0.05, 0.05, 0.15, 0.15, 0.5, 0.005, 0.005, 0.005]&apos;;
  
    noise = (noise_percent) * sensor_uncert .* randn(size(state_vector)); % 0.01 usually add noise_percent 1 2 3 4 5
    noisy_vector = state_vector + noise;

end</P>
      </eml>
    </state>
