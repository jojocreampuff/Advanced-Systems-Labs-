        <P Name="isEML">1</P>
        <P Name="script">function reward = fcn(err,u)
    err1 = err(1); % phi
    err2 = err(2); % phi_dot
    err3 = err(3);
    err4 = err(4);
    err5 = err(5);
    err6 = err(6);

    ux = u(1);
    uy = u(2);
    uz = u(3);

    reward = -1*(1*abs(err1) + 0.1*abs(err2) + 1*abs(err3) + 0.1*abs(err4) + ...
                    1*abs(err5) + 0.1*abs(err6) + 0.1*abs(ux) + 0.1*abs(uy) + 0.01*abs(uz));

end
</P>
