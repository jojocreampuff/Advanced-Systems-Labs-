<chart id="197">
  <P Name="name">drone2/Drone_Dynamic1/linear transfomation</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">197</P>
  <P Name="ssIdHighWaterMark">11</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">18</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">197</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [phi_dot, theta_dot, psi_dot] = fcn(p,q,r, phi,theta)

    phi_dot   = p + (q*sin(phi)*tan(theta)) + (r*cos(phi)*tan(theta));
    theta_dot = (q*cos(phi)) - (r*sin(phi));
    psi_dot   = (q*sin(phi)/cos(theta)) + (r*cos(phi)/cos(theta));

end



    % if theta == deg2rad(90) || theta == deg2rad(-90)
    %    theta = sign(theta)*deg2rad(89.9); 
    % end

% 89.9 value is fixed. 
% if change to 89.99, phi_dot and psi_dot value will explode.</P>
      </eml>
    </state>
