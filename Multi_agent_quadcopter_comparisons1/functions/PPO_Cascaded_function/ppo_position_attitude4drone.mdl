<?xml version="1.0" encoding="utf-8"?>
<chart id="429">
  <P Name="name">Ref Mixer</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">429</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">42</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">429</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [ref2, ref3, ref4] = fcn(t, leader, drone2, drone3, drone4)
ref2 = zeros(6,1);
ref3 = zeros(6,1);
ref4 = zeros(6,1);
N = 5000;
N1 = floor(N/3);
N2 = floor(2*N/3);

comm = 0;
offsets = zeros(3, 4);
offsets(:,1) = [ 0;  0; 0];
offsets(:,2) = [-1;  0; 0];
offsets(:,3) = [-1; -1; 0];
offsets(:,4) = [-1;  1; 0];
X1 = zeros(6,1);
X2 = zeros(6,1);
X3 = zeros(6,1);
X4 = zeros(6,1);

% eddie uses a weird vector format
% go from x xd y yd z zd =&gt; x y z xd yd zd (1,3,5,2,4,6)
X1 = [leader(1); leader(3); leader(5);leader(2);leader(4);leader(6)];

X2 = [drone2(1);drone2(3);drone2(5);drone2(2);drone2(4);drone2(6)];
X3 = [drone3(1);drone3(3);drone3(5);drone3(2);drone3(4);drone3(6)];
X4 = [drone4(1);drone4(3);drone4(5);drone4(2);drone4(4);drone4(6)];

    if comm == 0
        ref2 = [X1(1:3) + offsets(:,2); X1(4:6)];
        ref3 = [X1(1:3) + offsets(:,3); X1(4:6)];
        ref4 = [X1(1:3) + offsets(:,4); X1(4:6)];
    elseif comm == 1
        if t &lt;= (N1/2)*.01
            ref2 = [X1(1:3) + offsets(:,2); X1(4:6)];
            ref3 = [X1(1:3) + offsets(:,3); X1(4:6)];
            ref4 = [X1(1:3) + offsets(:,4); X1(4:6)];
        elseif t &lt;= N1*.01 &amp;&amp; t &gt; (N1/2)*.01
            ref2 = [X3(1:3) + (offsets(:,2) - offsets(:,3));   X3(4:6)]; % 2 only sees 3
            ref3 = [X1(1:3) + offsets(:,3);                    X1(4:6)]; % 2 only sees leader
            ref4 = [X2(1:3) + (offsets(:,4) - offsets(:,2));   X2(4:6)]; % 4 only sees 2
        elseif t &lt;= N2*.01 &amp;&amp; t &gt; N1*.01
            ref2 = [X1(1:3) + offsets(:,2);                    X1(4:6)]; % 2 only sees leader
            ref3 = [X2(1:3) + (offsets(:,3) - offsets(:,2));   X2(4:6)]; % 3 only sees 2
            ref4 = [X3(1:3) + (offsets(:,4) - offsets(:,3));   X3(4:6)]; % 4 only sees 3
        else
            ref2 = [X3(1:3) + (offsets(:,2) - offsets(:,3));   X3(4:6)]; % 2 only sees 3
            ref3 = [(X4(1:3) + (offsets(:,3)- offsets(:,4)));  X4(4:6)]; % 3 only sees 4
            ref4 = [X1(1:3) + offsets(:,4);                    X1(4:6)]; % 4 only sees leader
        end

    end
    % go from x y z xd yd zd =&gt; x xd y yd z zd (1,4,2,5,3,6)
    ref2 = [ref2(1); ref2(4); ref2(2); ref2(5); ref2(3); ref2(6)];
    ref3 = [ref3(1); ref3(4); ref3(2); ref3(5); ref3(3); ref3(6)];
    ref4 = [ref4(1); ref4(4); ref4(2); ref4(5); ref4(3); ref4(6)];
end</P>
      </eml>
    </state>
    <data SSID="4" name="t">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="leader">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
