<?xml version="1.0" encoding="utf-8"?>
<chart id="94">
  <P Name="name">Reference Signals/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">94</P>
  <P Name="ssIdHighWaterMark">10</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">8</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">trajectory_generator</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">94</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_desir, x_d_desir, y_desir, y_d_desir,...
    z_desir, z_d_desir] = trajectory_generator(t)
% trajectory_generator generates desired position and velocity.
    
    % x_desir = 10 * sin(0.25*t);
    % x_d_desir = 2.5 * cos(0.25*t);
    % y_desir = 70 * (1-exp(-0.01*t)) * cos(0.2*t);
    % y_d_desir = 70*(0.01*exp(-0.01*t))*cos(0.2*t) - 14*(1-exp(-0.01*t))*sin(0.2*t);
    
    x_desir = (1-exp(-0.01*t))*9.81*cos(0.2*t);
    x_d_desir = 9.81 * (0.01 * exp(-0.01 * t) * cos(0.2 * t) - 0.2 * (1 - exp(-0.01 * t)) * sin(0.2 * t));
    y_desir = (1-exp(-0.01*t))*9.81*sin(0.2*t);
    y_d_desir =  9.81 * (0.2 * (1 - exp(-0.01*t)) * cos(0.2*t) + 0.01 * exp(-0.01*t) * sin(0.2*t));
    z_desir = -0.1*t;
    z_d_desir = -0.1;
    
    % x_desir = 0;
    % x_d_desir = 0;
    % y_desir = 0;
    % y_d_desir =  0;
    % z_desir = -0.1*t;
    % z_d_desir = -0.1;
end</P>
      </eml>
    </state>
    <data SSID="4" name="t">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="x_desir">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
